# Copy to .env; every value below is required unless marked optional.
COMPOSE_PROJECT_NAME=webmonitor-agent
WEBMONITOR_HTTP_PORT=8080

# Released image used by compose.ghcr.yaml, e.g. ghcr.io/webmonitor/webmonitor-agent:0.1.0.
# Leave empty to build deploy/Dockerfile locally instead.
# One image backs both the `api` and `web` services.
WEBMONITOR_IMAGE=

# Database (tmpfs-backed in Compose: stopping the container discards this round).
POSTGRES_PASSWORD=replace-with-a-local-postgres-password

# Application.
APP_ORIGIN=http://localhost:8080
DEVELOPMENT_MODE=true
# At least 32 characters. Rotating it revokes CSRF tokens; sessions live in PostgreSQL.
SECRET_KEY=replace-with-at-least-32-random-characters
SESSION_TTL_HOURS=168
REGISTRATION_ALLOWED_EMAILS=

# First startup creates this administrator when the users table is empty.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
OPENAI_API_KEY=
OPENAI_BASE_URL=http://127.0.0.1:3425/v1
OPENAI_CONTAINER_BASE_URL=
OPENAI_MODEL=auto/GLM-5.3-Flash
# Per model call; the whole agent turn is capped by AGENT_TIMEOUT_SECONDS (300).
AGENT_MODEL_TIMEOUT_SECONDS=120

# Target policy: public (default), allowlist or any. Non-public needs DEVELOPMENT_MODE=true.
TARGET_POLICY=public
TARGET_ALLOWED_ORIGINS=

# Evidence storage. If S3_ROOT_PASSWORD is empty the MinIO root uses POSTGRES_PASSWORD.
S3_BUCKET=webmonitor-evidence
S3_ROOT_USER=webmonitor-admin
S3_ROOT_PASSWORD=

# Mail. Exactly one of SMTP_USE_SSL / SMTP_STARTTLS must be true.
SMTP_HOST=edu.icoremail.net
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=true
SMTP_STARTTLS=false
MAIL_FROM=

# Overlay target for compose.mocksite.yaml (the independent mocksite repo).
MOCKSITE_TARGET_ORIGIN=http://site:9000
# Network of the mocksite compose project (default: its project default network).
MOCKSITE_NETWORK=mocksite_default
